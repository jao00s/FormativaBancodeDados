GO

SELECT
    I.Nome,
    COUNT(A.IdAula) AS TotalAulas
FROM Instrutores I
LEFT JOIN Aulas A
    ON I.IdInstrutor = A.IdInstrutor
GROUP BY I.Nome;
GO

SELECT
    I.Nome,
    COUNT(A.IdAula) AS TotalAulas
FROM Instrutores I
INNER JOIN Aulas A
    ON I.IdInstrutor = A.IdInstrutor
GROUP BY I.Nome
HAVING COUNT(A.IdAula) >= 1;
GO

SELECT
    AcessoLivre,
    COUNT(*) AS TotalPlanos
FROM Planos
GROUP BY AcessoLivre;
GO

SELECT
    M.IdMatricula,
    C.Nome AS NomeCliente,
    P.NomePlano,
    M.DataInicio,
    M.StatusMatricula,
    M.Desconto
FROM Matriculas M
INNER JOIN Clientes C
    ON M.IdCliente = C.IdCliente
INNER JOIN Planos P
    ON M.IdPlano = P.IdPlano;
GO

SELECT
    A.IdAula,
    MO.NomeModalidade,
    I.Nome AS NomeInstrutor,
    A.DataAula,
    A.Horario,
    A.Vagas,
    A.Sala
FROM Aulas A
INNER JOIN Modalidades MO
    ON A.IdModalidade = MO.IdModalidade
INNER JOIN Instrutores I
    ON A.IdInstrutor = I.IdInstrutor;
GO

SELECT
    P.NomePlano,
    COUNT(M.IdMatricula) AS TotalMatriculas
FROM Planos P
LEFT JOIN Matriculas M
    ON P.IdPlano = M.IdPlano
GROUP BY P.NomePlano;
GO

SELECT
    C.Nome,
    C.Email,
    M.IdMatricula,
    M.StatusMatricula
FROM Clientes C
LEFT JOIN Matriculas M
    ON C.IdCliente = M.IdCliente;
GO

SELECT
    MO.NomeModalidade,
    A.IdAula,
    A.DataAula,
    A.Horario
FROM Modalidades MO
LEFT JOIN Aulas A
    ON MO.IdModalidade = A.IdModalidade;
GO

SELECT
    A.IdAula,
    MO.NomeModalidade,
    MO.Nivel,
    I.Nome AS NomeInstrutor,
    A.DataAula,
    A.Horario
FROM Aulas A
INNER JOIN Modalidades MO
    ON A.IdModalidade = MO.IdModalidade
INNER JOIN Instrutores I
    ON A.IdInstrutor = I.IdInstrutor
WHERE MO.Nivel = 'Intermediário';
